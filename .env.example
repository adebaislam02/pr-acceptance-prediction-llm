# Copy this file to .env and fill in real values. Never commit .env.

# OpenRouter API key — used by all 16 prompting scripts
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# GitHub personal access token — used ONLY by fetch_pr_dates.py
# Fine-grained token with default "Public repositories (read-only)"
# access is sufficient. Create one at:
#   https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=your-github-token-here
